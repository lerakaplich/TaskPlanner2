    }

    QLabel[required=&quot;true&quot;] {
        color: #D22730;
    }

    QLineEdit {
        background-color: white;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        color: #2c3e50;
