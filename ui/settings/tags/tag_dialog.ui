    QLineEdit:focus {
        border: 2px solid #D22730;
        background-color: #fff5f5;
    }

    QLineEdit:hover {
        border: 2px solid #ccab6e;
        background-color: #fffaf0;
    }

    QGroupBox {
        font-weight: bold;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        margin-top: 10px;
        padding-top: 10px;
    }

    QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 5px 0 5px;
        color: #D22730;
    }

    QComboBox {
        border: 2px solid #E0E0E0;
        border-radius: 8px;
        padding: 0px 16px;
        font-size: 14px;
        background-color: white;
        min-height: 35px;
        max-height: 35px;
        text-align: left;
		color: black;
    }

    QComboBox:hover {
        border: 2px solid #ccab6e;
    }

    QComboBox::drop-down {
        border: none;
        width: 30px;
    }

    QComboBox::down-arrow {
        image: none;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #D22730;
        width: 0;
        height: 0;
    }

    QComboBox QAbstractItemView {
        border-radius: 8px;
        background-color: white;
        selection-background-color: #D22730;
        selection-color: white;
        outline: none;
        padding: 4px;
    }

    QPushButton {
        background-color: #1B232A;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 0px 12px;
        font-size: 12px;
        min-height: 28px;
        max-height: 28px;
    }

    QPushButton:hover {
        background-color: #09131B;
    }

    QPushButton:pressed {
        background-color: #030B12;
    }

    QPushButton[primary=&quot;true&quot;] {
        background-color: #D22730;
        color: white;
        border-radius: 10px;
        font-weight: bold;
        font-size: 16px;
        border: none;
        padding: 12px 30px;
        min-width: 150px;
    }

    QPushButton[primary=&quot;true&quot;]:hover {
        background-color: #862633;
        border: 2px solid #ccab6e;
    }

    QPushButton[primary=&quot;true&quot;]:pressed {
        background-color: #6a1e29;
    }
    QScrollBar:vertical {
        background: #F5F5F5;
        width: 8px;
        border-radius: 4px;
    }
    QScrollBar::handle:vertical {
        background: #C1C1C1;
        border-radius: 4px;
        min-height: 20px;
    }
    QScrollBar:horizontal {
        border: none;
        background: #F5F5F5;
        height: 8px;
        margin: 0px;
        border-radius: 4px;
    }
    QScrollBar::handle:horizontal {
