  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #F5F5F7;
    font-family: 'Segoe UI', Arial;
}

/* Вкладки */
QTabBar::tab {
    background-color: white;
    color: #666;
    padding: 12px 20px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    font-weight: bold;
    font-size: 14px;
    min-width: 120px;
}

QTabBar::tab:selected {
    background-color: #1B232A;
    color: white;
    border-color: #1B232A;
}

QTabBar::tab:hover:!selected {
    background-color: #F0F0F0;
    border-color: #ccab6e;
}

QTabWidget::pane {
    background-color: white;
    border: 1x solid #E0E0E0;
    border-radius: 0px 8px 8px 8px;
    margin-top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
}

/* Кнопки */
QPushButton {
    min-height: 35px;
    max-height: 41px;
    border: none;
    border-radius: 10px;
    font-weight: bold;
    padding: 0px 16px;
}

/* === ВСЕ КНОПКИ «+ Добавить ...» — золотой стиль === */
QPushButton#btnAddHashtag,
QPushButton#btnAddEmployee,
QPushButton#btnAddDepartment,
QPushButton#btnAddSubdivision,
QPushButton#btnAddColumn {
    background-color: #ccab6e;
    color: white;
    font-size: 16px;
    border-radius: 10px;
    font-weight: bold;
    border: none;
    padding: 0 24px;           /* ← БЫЛО 12px 24px, теперь 0 по вертикали */
}

QPushButton#btnAddHashtag:hover,
QPushButton#btnAddEmployee:hover,
QPushButton#btnAddDepartment:hover,
QPushButton#btnAddSubdivision:hover,
QPushButton#btnAddColumn:hover {
    background-color: #998664;
}

QPushButton#btnAddHashtag:pressed,
QPushButton#btnAddEmployee:pressed,
QPushButton#btnAddDepartment:pressed,
QPushButton#btnAddSubdivision:pressed,
QPushButton#btnAddColumn:pressed {
    background-color: #7a6a50;
}

/* Остальные кнопки (редактировать, удалить и т.д.) — оставляем как было */
QPushButton#btnEdit,
QPushButton#btnDelete,
QPushButton#btnSave,
QPushButton#btnCancel {
    background-color: #1B232A;
    color: white;
    font-size: 14px;
    min-width: 80px;
}

QPushButton#btnEdit:hover,
QPushButton#btnDelete:hover,
QPushButton#btnSave:hover,
QPushButton#btnCancel:hover {
    background-color: #D9D9D6;
    color: black;
}

QPushButton#btnEdit:pressed,
QPushButton#btnDelete:pressed,
QPushButton#btnSave:pressed,
QPushButton#btnCancel:pressed {
    background-color: #B8B8B5;
}

/* Поля ввода */
QLineEdit, QTextEdit {
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    min-height: 41px;
}

QLineEdit:focus, QTextEdit:focus:focus {
    border: 2px solid #ccab6e;
}


/* Заголовки */
QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #1B232A;
    padding: 10px 0;
}

QLabel {
    font-size: 14px;
    font-weight: normal;
    color: #333;
}

QLabel#sectionTitle {
    font-size: 16px;
    font-weight: bold;
    color: #1B232A;
    padding: 5px 0;
}

/* Фреймы */
QFrame#headerFrame, QFrame#contentFrame {
    background-color: transparent;
}

QFrame#toolsFrame {
    background-color: white;
    border-radius: 10px;
    border: 1px solid #E0E0E0;
    padding: 15px;
}

QFrame#itemFrame {
    background-color: #F8F9FA;
    border-radius: 8px;
    border: 1px solid #E0E0E0;
    padding: 12px;
}

QFrame#itemFrame:hover {
    border-color: #ccab6e;
    background-color: #F0F0F0;
}

/* Таблица */
QTableWidget {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    gridline-color: #E0E0E0;
    font-size: 14px;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #F0F0F0;
}

QTableWidget::item:selected {
    background-color: #ccab6e;
    color: white;
}

QHeaderView::section {
    background-color: #F5F5F7;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    font-weight: bold;
    font-size: 14px;
    color: #1B232A;
}

/* Скроллбары */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #C1C1C1;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar:horizontal {
    border: none;
    background: #F5F5F5;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}</string>
