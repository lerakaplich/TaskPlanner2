  <property name="styleSheet">
   <string notr="true">
    QDialog {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    QLabel {
        color: #2c3e50;
        font-size: 13px;
        font-weight: 500;
    }

    QLabel[required=&quot;true&quot;] {
        color: #D22730;
    }

    QLineEdit, QTextEdit, QComboBox, QDateEdit {
        background-color: white;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        color: #2c3e50;
        min-height: 20px;
    }
    QComboBox {
        background-color: white;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        color: #2c3e50;
        min-height: 20px;
    }
    QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
        border: 2px solid #D22730;
        background-color: #fff5f5;
    }

    QLineEdit:hover, QTextEdit:hover, QComboBox:hover, QDateEdit:hover {
        border: 2px solid #ccab6e;
        background-color: #fffaf0;
    }

    QComboBox {
        min-height: 35px;
        max-height: 35px;
        padding: 0 16px;
        text-align: left;
    }

    QComboBox::drop-down {
        border: none;
        width: 30px;
    }

    QComboBox::down-arrow {
        image: none;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #D22730;
        width: 0;
        height: 0;
    }

    QComboBox QAbstractItemView {
        border: 2px solid #e9ecef;     /* светлая серая граница */
        border-radius: 8px;
        background-color: white;
        selection-background-color: #D22730;
        selection-color: white;
        outline: none;
        padding: 4px;
    }

    QGroupBox {
        font-weight: bold;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        margin-top: 10px;
        padding-top: 10px;
    }

    QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 5px 0 5px;
        color: #D22730;
    }

    QScrollBar:vertical {
        background: #F5F5F5;
        width: 8px;
        border-radius: 4px;
    }
    QScrollBar::handle:vertical {
        background: #C1C1C1;
        border-radius: 4px;
        min-height: 20px;
    }
    QScrollBar:horizontal {
        border: none;
        background: #F5F5F5;
        height: 8px;
        margin: 0px;
        border-radius: 4px;
    }
    QScrollBar::handle:horizontal {
        background: #c1c1c1;
        border-radius: 4px;
        min-width: 20px;
    }
    QScrollBar::add-line, QScrollBar::sub-line {
        border: none;
        background: none;
    }

    QPushButton#btnSave {
        background-color: #D22730;
        color: white;
        border-radius: 10px;
        font-weight: bold;
        font-size: 16px;
        border: none;
        padding: 12px 30px;
        min-width: 150px;
    }

    QPushButton#btnSave:hover {
        background-color: #862633;
        border: 2px solid #ccab6e;
    }

    QPushButton#btnSave:pressed {
        background-color: #6a1e29;
    }
   </string>
