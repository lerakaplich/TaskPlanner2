   </rect>
  </property>
  <property name="styleSheet">
   <string notr="true">/* Основные цвета */
QWidget#ProfilePage {
    background-color: #F5F5F7;
    font-family: 'Segoe UI', Arial;
}

/* Карточки */
QFrame[objectName^=&quot;frameBasicInfo&quot;],
QFrame[objectName^=&quot;frameSkills&quot;],
QFrame[objectName^=&quot;frameProjects&quot;],
QFrame[objectName^=&quot;frameChart&quot;] {
    background-color: white;
    border-radius: 12px;
    border: 1px solid #E0E0E0;
    padding: 20px;
}

/* Заголовки */
QLabel[objectName^=&quot;header&quot;] {
    font-size: 24px;
    font-weight: bold;
    color: #1B232A;
    padding-bottom: 10px;
    border-bottom: 2px solid #ccab6e;
}

QLabel[objectName^=&quot;subheader&quot;] {
    font-size: 18px;
    font-weight: bold;
    color: #1B232A;
    padding-bottom: 5px;
}

/* Прогресс-бары */
QProgressBar {
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    text-align: center;
    background-color: #F5F5F7;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #D22730;
    border-radius: 6px;
}

/* Звезды рейтинга */
QLabel[objectName^=&quot;star&quot;] {
    font-size: 24px;
}

/* Статистика */
QLabel[objectName^=&quot;statValue&quot;] {
    font-size: 32px;
    font-weight: bold;
    color: #D22730;
}

QLabel[objectName^=&quot;statLabel&quot;] {
    font-size: 14px;
    color: #666;
}

/* Информационные поля */
QLabel[objectName^=&quot;infoLabel&quot;] {
    font-size: 14px;
    font-weight: bold;
    color: #666;
    padding: 2px 0px;
}

QLabel[objectName^=&quot;infoValue&quot;] {
    font-size: 16px;
    color: #1B232A;
    padding: 2px 0px;
    padding-bottom: 8px;
}

/* Таблицы */
QTableWidget {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    gridline-color: #E0E0E0;
    selection-background-color: #FFF8E1;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #F0F0F0;
    min-height: 30px;
}

QTableWidget::item:selected {
    background-color: #FFF8E1;
    color: black;
}

QHeaderView::section {
    background-color: #F5F5F7;
    padding: 4px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    font-weight: bold;
    color: #1B232A;
    min-height: 30px;
}

/* Скроллбары */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollBar:vertical {
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #C1C1C1;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar:horizontal {
    border: none;
    background: #F5F5F5;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}</string>
  </property>
