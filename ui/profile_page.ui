   </rect>
  </property>
  <property name="styleSheet">
   <string notr="true">/* Основные цвета */
QWidget#ProfilePage {
    background-color: #F5F5F7;
    font-family: 'Segoe UI', Arial;
}

/* Карточки */
QFrame[objectName^="frameBasicInfo"],
QFrame[objectName^="frameSkills"],
QFrame[objectName^="frameProjects"],
QFrame[objectName^="frameChart"] {
    background-color: white;
    border-radius: 12px;
    border: 1px solid #E0E0E0;
    padding: 20px;
}

QFrame[objectName^="skillCard"] {
    background-color: white;
    border-radius: 10px;
    border: 1px solid #E0E0E0;
    padding: 15px;
}

QFrame[objectName^="projectCard"] {
    background-color: white;
    border-radius: 10px;
    border: 1px solid #E0E0E0;
    padding: 15px;
}

QFrame[objectName^="projectCard"]:hover {
    border: 2px solid #ccab6e;
    background-color: #FFFDF6;
}

/* Заголовки */
QLabel[objectName^="header"] {
    font-size: 24px;
    font-weight: bold;
    color: #1B232A;
    padding-bottom: 10px;
    border-bottom: 2px solid #ccab6e;
}

QLabel[objectName^="subheader"] {
    font-size: 18px;
    font-weight: bold;
    color: #1B232A;
    padding-bottom: 5px;
}

/* Прогресс-бары */
QProgressBar {
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    text-align: center;
    background-color: #F5F5F7;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #D22730;
    border-radius: 6px;
}

QProgressBar.gold::chunk {
    background-color: #ccab6e;
}

/* Звезды рейтинга */
QLabel[objectName^="star"] {
    font-size: 24px;
}

/* Статистика */
QLabel[objectName^="statValue"] {
    font-size: 32px;
    font-weight: bold;
    color: #D22730;
}

QLabel[objectName^="statLabel"] {
    font-size: 14px;
    color: #666;
}

/* Информационные поля */
QLabel[objectName^="infoLabel"] {
    font-size: 14px;
    font-weight: bold;
    color: #666;
    padding: 2px 0px;
}

QLabel[objectName^="infoValue"] {
    font-size: 16px;
    color: #1B232A;
    padding: 2px 0px;
    padding-bottom: 8px;
}

/* Таблицы */
QTableWidget {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    gridline-color: #E0E0E0;
    selection-background-color: #FFF8E1;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #F0F0F0;
}

QTableWidget::item:selected {
    background-color: #FFF8E1;
}

QHeaderView::section {
    background-color: #F5F5F7;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    font-weight: bold;
    color: #1B232A;
}

/* Графики */
QFrame[objectName^="chartFrame"] {
    background-color: white;
    border-radius: 10px;
    border: 1px solid #E0E0E0;
}</string>
  </property>
