  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #F5F5F7;
    font-family: 'Segoe UI', Arial;
}

/* Общие стили для кнопок */
QPushButton[styleClass=&quot;gold&quot;] {
    background-color: #ccab6e;
    color: white;
    border-radius: 10px;
    font-weight: bold;
    font-size: 18px;
    border: none;
    padding: 12px 24px;
}
QPushButton[styleClass=&quot;gold&quot;]:hover {
    background-color: #998664;
}
QPushButton[styleClass=&quot;gold&quot;]:pressed {
    background-color: #7a6a50;
}

QPushButton[styleClass=&quot;red&quot;] {
    background-color: #D22730;
    color: white;
    border-radius: 10px;
    font-weight: bold;
    font-size: 18px;
    border: none;
    padding: 12px 24px;
}
QPushButton[styleClass=&quot;red&quot;]:hover {
    background-color: #862633;
}
QPushButton[styleClass=&quot;red&quot;]:pressed {
    background-color: #6a1e29;
}

QPushButton[styleClass=&quot;gray&quot;] {
    background-color: #1B232A;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton[styleClass=&quot;gray&quot;]:hover {
    background-color: #D9D9D6;
    color: black;
}
QPushButton[styleClass=&quot;gray&quot;]:pressed {
    background-color: #B8B8B5;
}

/* Стили для карточек */
QFrame.projectCard {
    background-color: white;
    border-radius: 12px;
    border: 1px solid #E0E0E0;
}
QFrame.projectCard:hover {
    border: 2px solid #ccab6e;
    background-color: #FFFDF6;
}

/* Стили для прогресс-бара */
QProgressBar {
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    text-align: center;
    background-color: white;
    height: 20px;
}
QProgressBar::chunk {
    background-color: #D22730;
    border-radius: 6px;
}

/* Стили для меток проекта */
QLabel.projectInfo {
    font-size: 12px;
    color: #666;
    padding: 2px 0px;
}

QLabel.projectDate {
    font-size: 11px;
    color: #999;
    padding: 1px 0px;
}

QLabel.projectParticipants {
    font-size: 11px;
    color: #666;
    padding: 1px 0px;
}</string>
