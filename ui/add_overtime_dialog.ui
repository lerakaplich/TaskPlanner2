  <property name="styleSheet">
   <string>
QDialog {
    background-color: #FFFFFF;
}

/* Все поля ввода — строго 32 px */
QComboBox, QDateEdit, QTimeEdit {
    min-height: 32px;
    max-height: 32px;
    height: 32px;
    padding: 2px 8px 2px 8px;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: #FFFFFF;
    font-size: 14px;
}

QCalendarWidget QWidget {
    color: black;
    background-color: white;
}

QCalendarWidget QAbstractItemView {
    color: black;
    selection-background-color: #ccab6e;   /* ваш золотистый для дней */
    selection-color: white;
}

/* Кнопки навигации (предыдущий/следующий месяц) */
QCalendarWidget QToolButton {
    color: black;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 4px;
    min-width: 20px;
}
QCalendarWidget QToolButton:hover {
    background-color: #e6e6e6;
    border-radius: 4px;
}
QCalendarWidget QToolButton:pressed {
    background-color: #ccab6e;
    color: white;
}

/* Заголовок (дни недели) */
QCalendarWidget QHeaderView::section {
    color: black;
    background-color: #f2f2f2;
    font-weight: bold;
    padding: 6px;
}

/* Основное: меню выбора месяца и года — инверсия при наведении/выборе */
QCalendarWidget QMenu {
    background-color: white;
    color: black;
    border: 1px solid #E0E0E0;
}

QCalendarWidget QMenu::item {
    padding: 8px 24px;            /* удобный отступ */
    margin: 2px;
}

QCalendarWidget QMenu::item:selected {
    background-color: black;      /* инверсный фон */
    color: white;                 /* инверсный текст */
    border-radius: 4px;
}

/* Дополнительно — для года тоже инверсия */
QCalendarWidget #qt_calendar_yearbutton,
QCalendarWidget #qt_calendar_monthbutton {
    color: black;
    font-weight: bold;
}
QCalendarWidget #qt_calendar_yearbutton:hover,
QCalendarWidget #qt_calendar_monthbutton:hover {
    background-color: #e6e6e6;
}

/* QTimeEdit — стрелки вверх/вниз видимы */
QTimeEdit::up-button {
    width: 18px;
    height: 19px;
    padding: 0px;
}
QTimeEdit::down-button {
    width: 18px;
    height: 16px;
    padding: 0px;
}
QTimeEdit::up-arrow, QTimeEdit::down-arrow {
    width: 10px;
    height: 10px;
}

/* Текстовое поле */
QTextEdit {
    min-height: 80px;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 8px;
}

/* Кнопка Сохранить */
QPushButton#btnSave {
    min-height: 32px;
    max-height: 32px;
    background-color: #D22730;
    color: white;
    border-radius: 10px;
    font-weight: bold;
    font-size: 14px;
    padding: 4px 16px;
}
QPushButton#btnSave:hover {
    background-color: #862633;
}
   </string>
