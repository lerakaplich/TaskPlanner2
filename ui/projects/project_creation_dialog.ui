    QComboBox {
        background-color: white;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        color: #2c3e50;
        min-height: 20px;
    }
    QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
        border: 2px solid #D22730;
        background-color: #fff5f5;
    }

    QLineEdit:hover, QTextEdit:hover, QComboBox:hover, QDateEdit:hover {
        border: 2px solid #ccab6e;
        background-color: #fffaf0;
    }

    QComboBox {
        min-height: 35px;
        max-height: 35px;
        padding: 0 16px;
        text-align: left;
    }

    QComboBox::drop-down {
        border: none;
        width: 30px;
    }

    QComboBox::down-arrow {
        image: none;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #D22730;
        width: 0;
        height: 0;
    }

    QComboBox QAbstractItemView {
        border: 2px solid #e9ecef;     /* светлая серая граница */
        border-radius: 8px;
        background-color: white;
        selection-background-color: #D22730;
        selection-color: white;
        outline: none;
        padding: 4px;
    }

    QGroupBox {
