   </rect>
  </property>
  <property name="windowTitle">
   <string>Диаграмма Ганта</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    /* Основные цвета */
    QWidget {
        background-color: #0F1A24;
        color: #FFFFFF;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    /* Красные кнопки (основные действия) */
    QPushButton#primaryButton, QPushButton.btn-primary {
        background-color: #D22730;
        color: white;
        border-radius: 10px;
        font-weight: bold;
        font-size: 16px;
        border: none;
        padding: 10px 20px;
    }
    QPushButton#primaryButton:hover, QPushButton.btn-primary:hover {
        background-color: #862633;
    }
    QPushButton#primaryButton:pressed, QPushButton.btn-primary:pressed {
        background-color: #6a1e29;
    }

    /* Золотые кнопки (второстепенные действия) */
    QPushButton#goldButton, QPushButton.btn-gold {
        background-color: #ccab6e;
        color: white;
        border-radius: 10px;
        font-weight: bold;
        font-size: 16px;
        border: none;
        padding: 10px 20px;
    }
    QPushButton#goldButton:hover, QPushButton.btn-gold:hover {
        background-color: #998664;
    }
    QPushButton#goldButton:pressed, QPushButton.btn-gold:pressed {
        background-color: #7a6a50;
    }

    /* Серые кнопки (навигация, фильтры) */
    QPushButton#grayButton, QPushButton.btn-gray {
        background-color: #1B232A;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: bold;
    }
    QPushButton#grayButton:hover, QPushButton.btn-gray:hover {
        background-color: #D9D9D6;
        color: black;
    }
    QPushButton#grayButton:pressed, QPushButton.btn-gray:pressed {
        background-color: #B8B8B5;
    }

    /* Панели и контейнеры */
    QFrame {
        background-color: #1E2A36;
        border-radius: 12px;
        border: 1px solid #334756;
    }

    QFrame#sidebarFrame {
        background-color: #17212B;
        border-right: 2px solid #D22730;
    }

    /* Заголовки */
    QLabel.header-label {
        font-size: 24px;
        font-weight: bold;
        color: #ccab6e;
        padding: 10px;
    }

    QLabel.section-title {
        font-size: 18px;
        font-weight: bold;
        color: #FFFFFF;
        padding: 5px;
    }

    /* Список задач в сайдбаре */
    QListWidget {
        background-color: #1E2A36;
        border: none;
        border-radius: 8px;
        padding: 5px;
        outline: none;
    }

    QListWidget::item {
        background-color: #2A3743;
        border-radius: 8px;
        padding: 12px;
        margin: 4px;
        border-left: 4px solid #ccab6e;
    }

    QListWidget::item:selected {
        background-color: #D22730;
        border-left: 4px solid #FFFFFF;
    }

    QListWidget::item:hover {
        background-color: #3E4E5D;
    }

    /* Таблица для диаграммы Ганта */
    QTableWidget {
        background-color: #1E2A36;
        border: none;
        gridline-color: #334756;
    }

    QTableWidget::item {
        padding: 5px;
        border-bottom: 1px solid #334756;
    }

    QHeaderView::section {
        background-color: #17212B;
        color: #ccab6e;
        font-weight: bold;
        padding: 8px;
        border: none;
        border-right: 1px solid #334756;
        border-bottom: 2px solid #D22730;
    }

    /* Комбобоксы и спинбоксы */
    QComboBox, QDateEdit, QSpinBox {
        background-color: #1B232A;
        color: white;
        border: 1px solid #ccab6e;
        border-radius: 6px;
        padding: 8px;
        min-height: 20px;
    }

    QComboBox:hover, QDateEdit:hover, QSpinBox:hover {
        border: 1px solid #D22730;
    }

    QComboBox::drop-down {
        border: none;
    }

    QComboBox::down-arrow {
        image: url(:/icons/down_arrow.png);
        width: 12px;
        height: 12px;
    }

    /* Скроллбары */
    QScrollBar:vertical {
        background-color: #1E2A36;
        width: 12px;
        border-radius: 6px;
    }

    QScrollBar::handle:vertical {
        background-color: #ccab6e;
        border-radius: 6px;
        min-height: 30px;
    }

    QScrollBar::handle:vertical:hover {
        background-color: #D22730;
    }

    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
    }

    /* Линии связи на диаграмме */
    .dependency-line {
        color: #ccab6e;
        border: 2px dashed #ccab6e;
    }

    /* Полосы задач */
    .task-bar {
        border-radius: 6px;
        font-weight: bold;
    }

    .task-bar-critical {
        background-color: #D22730;
        border-left: 4px solid #FFFFFF;
    }

    .task-bar-high {
        background-color: #ccab6e;
        border-left: 4px solid #FFFFFF;
    }

    .task-bar-medium {
        background-color: #3498db;
        border-left: 4px solid #FFFFFF;
    }

    .task-bar-low {
        background-color: #2ecc71;
        border-left: 4px solid #FFFFFF;
    }

    /* Прогресс бар */
    QProgressBar {
        border: 1px solid #334756;
        border-radius: 5px;
        text-align: center;
        color: white;
        font-weight: bold;
    }

    QProgressBar::chunk {
        background-color: #D22730;
        border-radius: 5px;
    }
   </string>
